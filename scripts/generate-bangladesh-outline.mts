// Writes src/components/landing/map/bangladeshOutline.ts: the outline of Bangladesh, simplified for the landing page map.
//
//   npm i --no-save world-atlas topojson-client && npx tsx scripts/generate-bangladesh-outline.mts
//
// The source is the public domain Natural Earth 1:10m country layer (npm package world-atlas). The script keeps the
// mainland and every island big enough to show at the size the map is drawn, and thins each ring with Douglas-Peucker so
// the file stays small. The output is data, not code: regenerate it rather than editing it by hand.
import { readFileSync, writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { feature } from 'topojson-client';

const require = createRequire(import.meta.url);
const atlas = JSON.parse(readFileSync(require.resolve('world-atlas/countries-10m.json'), 'utf8'));
const country = atlas.objects.countries.geometries.find((item: { properties: { name: string } }) => item.properties.name === 'Bangladesh');
if (!country) throw new Error('Bangladesh is not in the atlas.');
const polygons: number[][][][] = (feature(atlas, country) as unknown as { geometry: { coordinates: number[][][][] } }).geometry.coordinates;

/** Distance tolerance in degrees. 0.01 is about 1 km, well under a pixel at the size the map is drawn. */
const TOLERANCE = 0.01;
/** Islands smaller than this (square degrees) are dropped: about 12 square kilometres. */
const MIN_AREA = 0.001;

type Point = [number, number];

function area(ring: Point[]): number {
  let sum = 0;
  for (let i = 0; i < ring.length - 1; i += 1) sum += ring[i][0] * ring[i + 1][1] - ring[i + 1][0] * ring[i][1];
  return Math.abs(sum) / 2;
}

function perpendicular(p: Point, a: Point, b: Point): number {
  const dx = b[0] - a[0];
  const dy = b[1] - a[1];
  const length = Math.hypot(dx, dy);
  if (length === 0) return Math.hypot(p[0] - a[0], p[1] - a[1]);
  return Math.abs(dy * p[0] - dx * p[1] + b[0] * a[1] - b[1] * a[0]) / length;
}

function simplify(points: Point[], tolerance: number): Point[] {
  const keep = new Array<boolean>(points.length).fill(false);
  keep[0] = true;
  keep[points.length - 1] = true;
  const stack: Array<[number, number]> = [[0, points.length - 1]];
  while (stack.length) {
    const [start, end] = stack.pop()!;
    let worst = 0;
    let index = -1;
    for (let i = start + 1; i < end; i += 1) {
      const distance = perpendicular(points[i], points[start], points[end]);
      if (distance > worst) {
        worst = distance;
        index = i;
      }
    }
    if (index !== -1 && worst > tolerance) {
      keep[index] = true;
      stack.push([start, index], [index, end]);
    }
  }
  return points.filter((_, i) => keep[i]);
}

const rings: number[][] = [];
for (const polygon of polygons) {
  const outer = polygon[0] as Point[];
  if (area(outer) < MIN_AREA) continue;
  const thinned = simplify(outer, TOLERANCE);
  rings.push(thinned.flatMap(([lon, lat]) => [Number(lon.toFixed(3)), Number(lat.toFixed(3))]));
}
rings.sort((a, b) => b.length - a.length);

const body = rings.map((ring) => `  [${ring.join(', ')}],`).join('\n');
writeFileSync(
  'src/components/landing/map/bangladeshOutline.ts',
  `// The outline of Bangladesh: one flat [lon, lat, lon, lat, ...] list per ring, mainland first, then the larger islands.
// Generated by scripts/generate-bangladesh-outline.mts from the public domain Natural Earth 1:10m country layer
// (npm package world-atlas), thinned with Douglas-Peucker. It is data, not code: regenerate it rather than editing it by hand.
export const BANGLADESH_RINGS: readonly (readonly number[])[] = [\n${body}\n];\n`,
);
console.log(`${rings.length} rings, ${rings.reduce((sum, ring) => sum + ring.length / 2, 0)} points`);
