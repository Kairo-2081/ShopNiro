APP_URL="http://localhost:3000"

SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_PROJECT.pooler.supabase.com:6543/postgres

# Alternatively, configure individual Supabase connection parameters:
SUPABASE_DB_HOST=YOUR_PROJECT.pooler.supabase.com
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PORT=6543

# SUPABASE API (Optional for Supabase JS client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CRON_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# Create a Groq API key at https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_FLASH=openai/gpt-oss-20b
GROQ_MODEL_PRO=openai/gpt-oss-120b

# Google Maps Platform Demo API Key
VITE_GOOGLE_MAPS_API_KEY=""

# SSLCommerz payment gateway
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_SANDBOX=true
PAYMENT_SIMULATOR=true
SSLCOMMERZ_IPN_TOKEN=dev-local-sslcommerz-ipn-token
